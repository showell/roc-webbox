-- **THE CHAT'S ROC, HUNTED WITH ROC'S OWN PARSER** (roc-ast,
-- tools/roc_ast/install.shale): constructs Steve's Roc style replaces
-- (memory: Roc idioms), one function a kind, each with plants
-- (plants/<hunt>.roc) that must fire before its findings count. The trees
-- are read once; a finding names its file, line and the definition it is in.
-- Run from roc-webbox:
--   shale tools/roc_hunt/hunt.shale               every hunt over chat/'s production modules
--   shale tools/roc_hunt/hunt.shale self_test=1   every hunt's plants first
-- The trees are some 20,000 lines, read a line at a time: the default
-- 5,000,000 steps do not reach the end of them, and the strings the hunts
-- make of them outgrow the default 16 MiB arena.
-- budget: steps=200000000 arena_bytes=1000000000
-- The production modules are chat/*.roc and chat/platform/*.roc, less
-- twin.roc (tests may hold literal data), and the modules of each package
-- chat/main.roc's header imports by path (the markdown, roc-markdown,
-- checked out beside roc-webbox).

const roc_ast = real("tools:roc-ast/bin/roc-ast")
-- Over this many parse nodes is long. The chat's largest definitions are
-- 304 nodes (main.roc's append_message_by!), then 281; 290 sits between, so
-- the one the old 40-line rule found is the one this finds.
const long_nodes = 290

-- ── the trees ────────────────────────────────────────────────────────────

-- roc-ast's output for `files`, read once: each line, its depth (leading
-- tabs), its file, and the definition it is in (`name`, or "").
function read_trees(files)
  local dump = run({roc_ast}, {timeout_ms = 300000, stdin = join(files, "\n"), whole = 64000000})
  -- A file that does not parse stops roc-ast there, its trees so far
  -- printed: hunting those would pass the rest unread.
  if dump.ended ~= "exit" or dump.code ~= 0 then
    local said = lines(trim(dump.out))
    fail("roc-ast: " .. (said[#said] or dump.ended))
  end
  local text = lines(dump.out)
  local depth = {}
  local file = {}
  local within = {}
  local current = ""
  local stack = {}
  local i = 1
  while i <= #text do
    local line = text[i]
    local d = 0
    while sub(line, d + 1, d + 1) == "\t" do d = d + 1 end
    push(depth, d)
    if starts_with(line, "== ") then
      current = sub(line, 4)
      stack = {}
    end
    while #stack > 0 and stack[#stack][1] >= d do stack = take(stack, #stack - 1) end
    local t = trim(line)
    if (starts_with(t, "(s-decl ") or starts_with(t, "(s-type-anno ")) and i < #text then
      local name = between(t, "(name \"", "\")")
      if name == nil or name == "" then name = between(trim(text[i + 1]), "(raw \"", "\")") end
      -- A destructure (`(a, b) = ...`) names nothing: it is its
      -- definition's.
      if (name == nil or name == "") and #stack > 0 then name = stack[#stack][2] end
      push(stack, {d, name or "", false})
    end
    -- A type's own name (`Row : { dm : Bool }`), for what is inside it; a
    -- module's type (`Html := [].{ ... }`) holds the definitions, which
    -- name themselves.
    if starts_with(t, "(s-type-decl ") and i < #text then
      push(stack, {d, between(trim(text[i + 1]), "(name \"", "\")") or "", true})
    end
    push(file, current)
    -- The outermost value definition, not the innermost: a local's name
    -- (`id`, `path`) recurs across definitions, and a finding grouped by it
    -- landed under another definition's line. Outside any, the innermost
    -- type's.
    local named = ""
    for s in stack do if named == "" and not s[3] then named = s[2] end end
    if named == "" and #stack > 0 then named = stack[#stack][2] end
    push(within, named)
    i = i + 1
  end
  return {text = text, depth = depth, file = file, within = within}
end

-- The line after the last line of the node at `at`.
function past(tree, at)
  local i = at + 1
  while i <= #tree.text and tree.depth[i] > tree.depth[at] do i = i + 1 end
  return i
end

-- The lines of the node at `at`'s children.
function children(tree, at)
  local out = {}
  local stop = past(tree, at)
  local i = at + 1
  while i < stop do
    if tree.depth[i] == tree.depth[at] + 1 then push(out, i) end
    i = i + 1
  end
  return out
end

-- The node at `at`'s first line, trimmed.
function head(tree, at)
  return trim(tree.text[at])
end

-- Where a finding is: `<file>:<line> <definition>`.
function where(tree, at)
  return tree.file[at] .. ":" .. between(head(tree, at), "@", ".") .. " " .. tree.within[at]
end

-- The type at `at`, as Roc writes it: `List(U8)`, `{ id : U8 }`, `[A, B]`.
function render(tree, at)
  local t = head(tree, at)
  local kids = children(tree, at)
  local name = between(t, "(name \"", "\")")
  if starts_with(t, "(ty-apply ") then
    local args = {}
    local k = 2
    while k <= #kids do push(args, render(tree, kids[k])) k = k + 1 end
    return render(tree, kids[1]) .. "(" .. join(args, ", ") .. ")"
  end
  if starts_with(t, "(ty-record ") or starts_with(t, "(ty-tuple ") or starts_with(t, "(tags") then
    local parts = {}
    for k in kids do push(parts, render(tree, k)) end
    if starts_with(t, "(ty-record ") then return "{ " .. join(parts, ", ") .. " }" end
    if starts_with(t, "(ty-tuple ") then return "(" .. join(parts, ", ") .. ")" end
    return join(parts, ", ")
  end
  if starts_with(t, "(ty-tag-union ") then return "[" .. render(tree, kids[1]) .. "]" end
  if starts_with(t, "(anno-record-field ") then return name .. " : " .. render(tree, kids[1]) end
  -- A function type, its arguments and result: two callbacks of different
  -- types differ. roc-ast writes `->` and `=>` alike.
  if starts_with(t, "(ty-fn ") then
    local args = {}
    local k = 1
    while k < #kids do push(args, render(tree, kids[k])) k = k + 1 end
    return "(" .. join(args, ", ") .. " -> " .. render(tree, kids[#kids]) .. ")"
  end
  if name ~= nil and name ~= "" then return name end
  -- A type variable (`ty-var`) carries its name as `raw`: `List(a)` and
  -- `List(b)` differ.
  local raw = between(t, "(raw \"", "\")")
  if raw ~= nil and raw ~= "" then return raw end
  return split(t, " ")[1] .. ")"
end

-- Whether the type at `at` holds a `Bool` anywhere but inside a function
-- type: `Bool`, `Try(Bool, _)`, `(Bool, U64)`, `List(Bool)`. A callback's
-- Bool (`U8 -> Bool`) is its answer, a predicate's, not a flag; a record's
-- fields are not looked into.
function holds_bool(tree, at)
  local t = head(tree, at)
  if starts_with(t, "(ty-fn ") then return false end
  -- A record's fields are judged one by one (`bools`' field check).
  if starts_with(t, "(ty-record ") then return false end
  if starts_with(t, "(ty ") and between(t, "(name \"", "\")") == "Bool" then return true end
  for k in children(tree, at) do
    if holds_bool(tree, k) then return true end
  end
  return false
end

-- **THE NAMES THE LANGUAGE FIXES**: the methods Roc's syntax and builtins
-- call by name (docs/langref/static-dispatch.md's table: `==` calls
-- `is_eq`, `<` `is_lt`, `+` `plus`, `!` `not`; operators.md's `[...]`
-- calls `subscript`), and the encoding protocol's `encode` and `decode`,
-- which a format calls by name. Their signatures are the language's, not
-- the author's: no hunt of a signature (same_typed_args, bools'
-- arguments, bool_returns) judges them.
const fixed_names = " to_inspect is_eq to_hash plus minus times div_by div_trunc_by rem_by is_lt is_lte is_gt is_gte range_exclusive_to range_inclusive_to range_exclusive_from range_inclusive_from range_iter range_len_if_known negate not from_numeral from_quote from_interpolation iter next parser_for encoder_for map map! subscript encode decode "

function is_fixed(name)
  return contains(fixed_names, " " .. name .. " ")
end

-- Each annotated function's argument types: {at, name, args} where args
-- are the lines of its `ty-fn`'s children but the last (the return type).
-- A name the language fixes is left out.
function annotated_functions(tree)
  local out = {}
  local i = 1
  while i < #tree.text do
    if starts_with(head(tree, i), "(s-type-anno ") and starts_with(head(tree, i + 1), "(ty-fn ") then
      local name = between(head(tree, i), "(name \"", "\")") or ""
      if not is_fixed(name) then
        local kids = children(tree, i + 1)
        push(out, {at = i, name = name, args = take(kids, #kids - 1)})
      end
    end
    i = i + 1
  end
  return out
end

-- The `if` that the `if` at `at`'s `else` is, or nil.
function else_if(tree, at)
  local kids = children(tree, at)
  local last = kids[#kids]
  if last == nil then return nil end
  if starts_with(head(tree, last), "(e-if-then-else ") then return last end
  if starts_with(head(tree, last), "(e-block ") then
    local block = children(tree, last)
    if #block == 1 and starts_with(head(tree, block[1]), "(statements") then
      local inside = children(tree, block[1])
      if #inside == 1 and starts_with(head(tree, inside[1]), "(e-if-then-else ") then return inside[1] end
    end
  end
  return nil
end

-- ── the hunts ────────────────────────────────────────────────────────────

-- **NEIGHBOURING ARGUMENTS OF ONE TYPE**: swapped, they still type-check.
-- A record names them; a nominal type tells them apart. Type variables
-- (`a, a`, a comparator's two sides) are not counted, nor is a name the
-- language fixes (`is_eq`, `is_lt`, `minus`: see fixed_names). **NOR IS AN
-- OPERATION NO ORDER CHANGES** (order_free): `union(a, b)` is
-- `union(b, a)`, so a swap there is no bug, and a record would only make
-- one of two equal sides look first.
const order_free = " union intersection max min plus times bitwise_and bitwise_or bitwise_xor abs_diff "

function same_typed_args(tree)
  local found = {}
  for f in annotated_functions(tree) do
    local types = {}
    if not contains(order_free, " " .. f.name .. " ") then
      for a in f.args do push(types, render(tree, a)) end
    end
    local a = 1
    while a < #types do
      local b = a
      while b < #types and types[b + 1] == types[a] do b = b + 1 end
      if b > a and not contains(head(tree, f.args[a]), "ty-var") then
        push(found, where(tree, f.at) .. ": arguments " .. tostring(a) .. "-" .. tostring(b) .. " are " .. types[a])
      end
      a = b + 1
    end
  end
  return found
end

-- **A NUMBER THAT MEANS SOMETHING IT DOES NOT SAY**: a number literal, in
-- an expression or a pattern: an integer, a typed one (`200.U8`), a
-- fraction (`0.75`, `0.5.F32`). One between 32 and 126 is most likely a
-- byte, which a character literal ('_') says, and is marked `'?`, unless
-- it is a shift's or a mask's operand (`shift_left_by`, `bitwise_and`),
-- which is a bit count or a mask. A line a definition: where its first one
-- is, then each.
--
-- **A DEFINITION THAT IS ONE LITERAL IS NO FINDING** (`min_shifts = 32`,
-- `limit = 200.U8`): it names the number, which is the fix, not the fault.
--
-- **0 AND 1 ARE NOT FLAGGED**, typed or not: they are the start, the step
-- and the empty (`index + 1`, `len == 0`) on nearly every line that
-- counts, and a hunt that flagged them would bury the numbers that mean
-- something. **BUT ONE EXPRESSION COMPARED TO TWO DIFFERENT LITERALS** in
-- one `match` (`0 => "ok"`, `1 => "bad"`) or one `if` chain (`x == 0` ...
-- `else if x == 1`) is a closed set of codes a tag would name, and those
-- literals are flagged, 0 and 1 too, marked `(compared in turn)`.
const number_nodes = {"(e-int ", "(p-int ", "(e-typed-int ", "(p-typed-int ", "(e-frac ", "(p-frac ", "(e-typed-frac ", "(p-typed-frac "}
const zero_and_one = " 0 1 0.0 1.0 "

function is_number(tree, at)
  for kind in number_nodes do if starts_with(head(tree, at), kind) then return true end end
  return false
end

-- The line of the node that holds the node at `at`.
function parent(tree, at)
  local j = at - 1
  while j > 1 and tree.depth[j] >= tree.depth[at] do j = j - 1 end
  return j
end

-- The node at `at` and all under it, its places left out: two copies of
-- one expression read alike.
function shape(tree, at)
  local parts = {}
  local stop = past(tree, at)
  local i = at
  while i < stop do
    push(parts, re_replace(head(tree, i), "@[0-9.-]+", ""))
    i = i + 1
  end
  return join(parts, " ")
end

-- Whether the number at `at` is a definition's whole value (`x = 32`).
function is_constant(tree, at)
  return at > 2 and starts_with(head(tree, at - 1), "(p-ident ") and tree.depth[at - 1] == tree.depth[at] and starts_with(head(tree, at - 2), "(s-decl ") and tree.depth[at - 2] == tree.depth[at] - 1
end

-- Whether the number at `at` is a shift's or mask's operand: an argument
-- of a call (`U64.shift_right_by(x, 56)`) or a method call
-- (`x.bitwise_and(255)`) whose name starts `shift_`, `shl_`, `shr_`
-- (`shr_zf_wrap`) or `bitwise_`.
function is_bit_operand(tree, at)
  local p = parent(tree, at)
  local callee = ""
  if starts_with(head(tree, p), "(e-apply ") then
    local named = between(head(tree, p + 1), "(raw \"", "\")") or ""
    local parts = split(named, ".")
    callee = parts[#parts]
  end
  if head(tree, p) == "(args" then callee = between(head(tree, parent(tree, p)), "(method \".", "\")") or "" end
  return starts_with(callee, "shift_") or starts_with(callee, "shl_") or starts_with(callee, "shr_") or starts_with(callee, "bitwise_")
end

-- The numbers one expression is compared to in turn, `{[line] = true}`:
-- a `match`'s number patterns, or the `x == <number>` conditions of one
-- `if` chain, grouped by the expression; each group of two or more
-- different literals.
function compared_in_turn(tree)
  local marked = {}
  local i = 1
  while i <= #tree.text do
    local t = head(tree, i)
    -- Each group: the expression's shape, then its literals' lines.
    local groups = {}
    local keys = {}
    if starts_with(t, "(e-match") then
      push(keys, "match")
      groups["match"] = {}
      for part in children(tree, i) do
        if head(tree, part) == "(branches" then
          for b in children(tree, part) do
            local pattern = children(tree, b)[1]
            if pattern ~= nil and is_number(tree, pattern) then push(groups["match"], pattern) end
          end
        end
      end
    end
    if starts_with(t, "(e-if-then-else ") then
      local at = i
      while at ~= nil do
        local cond = children(tree, at)[1]
        if starts_with(head(tree, cond), "(e-binop ") and contains(head(tree, cond), "(op \"==\")") then
          local sides = children(tree, cond)
          local literal = nil
          local other = nil
          if is_number(tree, sides[2]) and not is_number(tree, sides[1]) then
            literal = sides[2]
            other = sides[1]
          end
          if is_number(tree, sides[1]) and not is_number(tree, sides[2]) then
            literal = sides[1]
            other = sides[2]
          end
          if literal ~= nil then
            local key = shape(tree, other)
            if get(groups, key) == nil then
              push(keys, key)
              groups[key] = {}
            end
            push(groups[key], literal)
          end
        end
        at = else_if(tree, at)
      end
    end
    for key in keys do
      local raws = {}
      local different = 0
      for at in groups[key] do
        local raw = between(head(tree, at), "(raw \"", "\")") or ""
        if get(raws, raw) == nil then
          raws[raw] = true
          different = different + 1
        end
      end
      if different >= 2 then
        for at in groups[key] do marked[tostring(at)] = true end
      end
    end
    i = i + 1
  end
  return marked
end

function magic_numbers(tree)
  local in_turn = compared_in_turn(tree)
  local order = {}
  local first = {}
  local numbers = {}
  local i = 1
  while i <= #tree.text do
    if is_number(tree, i) and not is_constant(tree, i) then
      local t = head(tree, i)
      local raw = between(t, "(raw \"", "\")")
      local turn = get(in_turn, tostring(i)) ~= nil
      if turn or not contains(zero_and_one, " " .. raw .. " ") then
        local n = parse_int(raw)
        if n ~= nil and n >= 32 and n <= 126 and not is_bit_operand(tree, i) then raw = raw .. "'?" end
        local typed = between(t, "(type \"", "\")")
        if typed ~= nil and typed ~= "" then raw = raw .. "." .. typed end
        if turn and contains(zero_and_one, " " .. between(t, "(raw \"", "\")") .. " ") then raw = raw .. " (compared in turn)" end
        local key = tree.file[i] .. " " .. tree.within[i]
        if get(first, key) == nil then
          push(order, key)
          first[key] = where(tree, i)
          numbers[key] = {}
        end
        push(numbers[key], raw)
      end
    end
    i = i + 1
  end
  local found = {}
  for key in order do push(found, first[key] .. ": " .. join(numbers[key], ", ")) end
  return found
end

-- **A BOOL WHERE A TAG WOULD SAY WHICH**: an argument whose type holds a
-- `Bool` (`Bool`, `(Bool, U64)`, `List(Bool)`; not a callback's answer), a
-- record field whose type does, a tag's payload in a type declaration
-- (`Mark := [Seen(Bool), Unseen]`), or a call handed a bare `True` or
-- `False`, qualified or not (`decode(bytes, True)`,
-- `JsonOut.bool(Bool.False)`), which finds the unannotated helper too. A
-- return of `Bool` is `bool_returns`' to judge; a name the language fixes
-- (`is_eq : Bool, Bool -> Bool`) is not judged.
function bools(tree)
  local found = {}
  for f in annotated_functions(tree) do
    local n = 1
    while n <= #f.args do
      if holds_bool(tree, f.args[n]) then push(found, where(tree, f.at) .. ": argument " .. tostring(n) .. " is a Bool") end
      n = n + 1
    end
  end
  local i = 1
  while i <= #tree.text do
    local t = head(tree, i)
    if starts_with(t, "(anno-record-field ") then
      local kids = children(tree, i)
      if #kids > 0 and holds_bool(tree, kids[1]) then
        push(found, where(tree, i) .. ": field " .. between(t, "(name \"", "\")") .. " is a Bool")
      end
    end
    -- A type declaration's own tags: `Seen(Bool)`.
    if starts_with(t, "(s-type-decl ") then
      for u in children(tree, i) do
        if starts_with(head(tree, u), "(ty-tag-union ") then
          for tags in children(tree, u) do
            for tag in children(tree, tags) do
              if starts_with(head(tree, tag), "(ty-apply ") then
                local parts = children(tree, tag)
                for payload in drop(parts, 1) do
                  if holds_bool(tree, payload) then push(found, where(tree, tag) .. ": tag " .. render(tree, parts[1]) .. "'s payload is a Bool") end
                end
              end
            end
          end
        end
      end
    end
    -- A call's arguments: an `e-apply`'s children after the callee (a tag
    -- applied, `Ok(True)`, makes a value and is no call), or a method
    -- call's `args`.
    local callee = nil
    local args = {}
    if starts_with(t, "(e-apply ") then
      local kids = children(tree, i)
      if not starts_with(head(tree, kids[1]), "(e-tag ") then
        callee = between(head(tree, kids[1]), "(raw \"", "\")") or "a function"
        args = drop(kids, 1)
      end
    end
    if starts_with(t, "(e-method-call ") then
      callee = between(t, "(method \"", "\")")
      for k in children(tree, i) do
        if starts_with(head(tree, k), "(args") then args = children(tree, k) end
      end
    end
    for a in args do
      local tag = between(head(tree, a), "(raw \"", "\")")
      if starts_with(head(tree, a), "(e-tag ") and (tag == "True" or tag == "False" or tag == "Bool.True" or tag == "Bool.False") then
        push(found, where(tree, a) .. ": a bare " .. tag .. " passed to " .. callee)
      end
    end
    i = i + 1
  end
  return found
end

-- **A LIST READ BY POSITION**: a function taking a `List(List(U8))` and
-- reading it with `List.get`, whose parts are known only by where they sit
-- (`doc, secs, uid, name...`, nine a row). A record, or a tag with a
-- payload, names them. A list of like things (lines, names) walked whole is
-- not one. The host seam keeps some on purpose; inside Roc none should
-- survive.
function positional_lists(tree)
  local found = {}
  for f in annotated_functions(tree) do
    local flat = false
    for a in f.args do if render(tree, a) == "List(List(U8))" then flat = true end end
    if flat then
      -- The definition is the annotation's next sibling; a `get` anywhere
      -- in it counts, inside a helper it defines too (`at = |k| ...`).
      local decl = past(tree, f.at)
      local gets = 0
      if decl <= #tree.text and starts_with(head(tree, decl), "(s-decl ") then
        local i = decl
        local stop = past(tree, decl)
        while i < stop do
          local t = head(tree, i)
          if contains(t, "(raw \"List.get\")") or contains(t, "(method \".get\")") then gets = gets + 1 end
          i = i + 1
        end
      end
      if gets > 0 then push(found, where(tree, f.at) .. ": a List(List(U8)) read by position (" .. tostring(gets) .. " gets)") end
    end
  end
  return found
end

-- **AN IF CHAIN THAT A MATCH WOULD SAY**: an `if` whose `else` is another
-- `if`, three or more deep, the `else` bare (`else if`) or a block holding
-- that `if` alone (`else { if ... }`); or three or more guards in a row in
-- one block, each an `if` with no `else` whose block ends in `return`.
-- Often a closed set of cases told apart by comparing, where a tag and a
-- `match` would be exhaustive.

-- Whether the node at `at` is a guard: an `if` with no `else` whose block's
-- last statement is a `return`.
function guard(tree, at)
  if not starts_with(head(tree, at), "(e-if-without-else ") then return false end
  local kids = children(tree, at)
  local block = kids[#kids]
  if block == nil or not starts_with(head(tree, block), "(e-block ") then return false end
  for s in children(tree, block) do
    if starts_with(head(tree, s), "(statements") then
      local body = children(tree, s)
      return #body > 0 and starts_with(head(tree, body[#body]), "(s-return ")
    end
  end
  return false
end

function if_chains(tree)
  local found = {}
  local inner = {}
  local i = 1
  while i <= #tree.text do
    if starts_with(head(tree, i), "(e-if-then-else ") then
      local next = else_if(tree, i)
      if next ~= nil then inner[tostring(next)] = true end
    end
    i = i + 1
  end
  i = 1
  while i <= #tree.text do
    if starts_with(head(tree, i), "(e-if-then-else ") and get(inner, tostring(i)) == nil then
      local n = 1
      local at = else_if(tree, i)
      while at ~= nil do
        n = n + 1
        at = else_if(tree, at)
      end
      if n >= 3 then push(found, where(tree, i) .. ": " .. tostring(n) .. " ifs in a chain") end
    end
    if starts_with(head(tree, i), "(statements") then
      local run_start = nil
      local n = 0
      for s in children(tree, i) do
        if guard(tree, s) then
          if n == 0 then run_start = s end
          n = n + 1
        else
          if n >= 3 then push(found, where(tree, run_start) .. ": " .. tostring(n) .. " guards that return, in a row") end
          n = 0
        end
      end
      if n >= 3 then push(found, where(tree, run_start) .. ": " .. tostring(n) .. " guards that return, in a row") end
    end
    i = i + 1
  end
  return found
end

-- **A LONG DEFINITION**: one of more than `long_nodes` parse nodes, largest
-- first. Not wrong by itself; the place to look for a function to name.
-- Nodes, not lines: a call stacked one argument a line is more lines and no
-- more code.
function long_definitions(tree)
  local found = {}
  local i = 1
  while i <= #tree.text do
    if starts_with(head(tree, i), "(s-decl ") then
      local nodes = past(tree, i) - i
      if nodes > long_nodes then
        -- Keyed by the size, zero-padded, so a sort of the strings is a
        -- sort by size.
        local key = tostring(nodes)
        while #key < 6 do key = "0" .. key end
        push(found, key .. "|" .. where(tree, i) .. ": " .. tostring(nodes) .. " nodes")
      end
    end
    i = i + 1
  end
  local out = {}
  local sorted = sort(found)
  local k = #sorted
  while k >= 1 do
    push(out, sub(sorted[k], 8))
    k = k - 1
  end
  return out
end

-- **THE DISK REACHED AROUND FILES.ROC**: a call to one of Host's file
-- primitives anywhere but chat/Files.roc (and chat/test/, whose probes test
-- the seam itself). Files.roc takes only a Paths.ChatPath, which only
-- Paths.roc can make (`::`, opaque), so a path through it is one Paths
-- named. The platform's table names the primitives without calling them.
const file_primitives = " read! write! remove! list! append! serve_file! serve_rendered! "

function fs_bypass(tree)
  local found = {}
  local i = 1
  while i < #tree.text do
    if starts_with(head(tree, i), "(e-apply ") and tree.file[i] ~= "chat/Files.roc" and not starts_with(tree.file[i], "chat/test/") then
      local callee = between(head(tree, i + 1), "(raw \"", "\")")
      if callee ~= nil and starts_with(callee, "Host.") and contains(file_primitives, " " .. sub(callee, 6) .. " ") then
        push(found, where(tree, i) .. ": " .. callee .. " outside Files.roc")
      end
    end
    i = i + 1
  end
  return found
end

-- **MARKUP TRUSTED THAT THE CODE DID NOT WRITE**: an `Html` (chat/Html.roc,
-- opaque) is made from bytes only by `escape`, or by `trusted`, which takes
-- markup as written: so a call to `Html.trusted` whose argument is not a
-- string literal with no interpolation (or `Html.trusted` passed as a
-- value, its argument unseen), or a literal holding an odd number of `"`,
-- which leaves an attribute's quotes open for a value to be spliced into: an
-- element with attributes is `Html.tag`'s, its values always escaped.
-- `Html.host_markup` (the host's rendered markdown)
-- is called in chat/Chrome.roc alone (and Html.roc's expects), and `Html.twin_script_json` by the
-- twins alone (chat/twin.roc is never in the tree).
function html_trusted_nonliteral(tree)
  local found = {}
  local i = 1
  while i < #tree.text do
    local t = head(tree, i)
    local callee = between(t, "(raw \"", "\")")
    if starts_with(t, "(e-ident ") and callee ~= nil then
      local applied = i > 1 and starts_with(head(tree, i - 1), "(e-apply ") and tree.depth[i] == tree.depth[i - 1] + 1
      if callee == "Html.trusted" then
        local literal = false
        if applied then
          local a = past(tree, i)
          local at = head(tree, a)
          if a <= #tree.text and tree.depth[a] == tree.depth[i] and (starts_with(at, "(e-string ") or starts_with(at, "(e-multiline-string ")) then
            literal = true
            local quotes = 0
            for c in children(tree, a) do
              local part = head(tree, c)
              if not starts_with(part, "(e-string-part ") then literal = false end
              local raw = between(part, "(raw \"", "\")") or ""
              local k = find(raw, "\"")
              while k ~= nil do
                quotes = quotes + 1
                k = find(raw, "\"", k + 1)
              end
            end
            if literal and quotes % 2 == 1 then push(found, where(tree, i) .. ": Html.trusted leaves an attribute open: build the element with Html.tag") end
          end
        end
        if not literal then push(found, where(tree, i) .. ": Html.trusted of no string literal") end
      end
      if callee == "Html.host_markup" and tree.file[i] ~= "chat/Chrome.roc" and tree.file[i] ~= "chat/Html.roc" then
        push(found, where(tree, i) .. ": Html.host_markup outside Chrome.roc")
      end
      if callee == "Html.twin_script_json" then
        push(found, where(tree, i) .. ": Html.twin_script_json outside twin.roc")
      end
    end
    i = i + 1
  end
  return found
end

-- **A BOOL ANSWER THAT ISN'T A QUESTION'S**: a function that returns
-- `Bool` is answering a question, and its name says so (`is_`, `has_`,
-- `can_`: `is_topic_id`, `channel_is_open`). Any other Bool return is a
-- decision that wants a tag (`[Roc, Zig]`, not "true: the Roc serves it")
-- or a failure that wants a `Try` (`appended!` answering false when the
-- store failed). The result counts when its type holds a `Bool` anywhere
-- but in a function type: `Try(Bool, _)` and `(Bool, U64)` do; a `where`
-- clause is no part of the result. A name the language fixes (`subscript`,
-- `not`, `decode`: see fixed_names) answers a Bool by the language's
-- contract, and is not judged.
function bool_returns(tree)
  local found = {}
  for f in annotated_functions(tree) do
    local kids = children(tree, f.at + 1)
    local name = between(head(tree, f.at), "(name \"", "\")") or ""
    if #kids > 0 and holds_bool(tree, kids[#kids]) and re_find(name, "^is_|_is_|^has_|_has_|^can_|_can_") == nil then
      push(found, where(tree, f.at) .. ": returns a Bool, and `" .. name .. "` is not a question's name")
    end
  end
  return found
end

-- **A MODULE A READER MUST OPEN FOR ONE CALLER** (metal-vmm QUEUE 300;
-- Steve: "We don't want to force folks to read 5 different modules to
-- understand a code flow"): a module whose production references (a
-- qualified `Module.name`, outside an `expect`) all come from one other
-- module, `twin` counting as a caller, belongs with that caller, unless
-- `kept_alone` names it with its reason. Only the trees' own modules are
-- callees: a builtin (`Iter`, `List`) one module alone uses is no module to
-- move. `trees` are the production trees and twin's.
const kept_alone = {
  -- The platform: the app's boundary, whoever calls it.
  Chat = "the platform's types, the app's boundary",
  Host = "the platform's hosted functions, the app's boundary",
  -- A route whole: main's dispatch is its one caller, and the route's
  -- flow is read in one module, not main's thousands of lines.
  Docs = "the docs feature whole (/chat/docs): main only dispatches to it",
  Upload = "an upload's route whole (POST and GET): main only dispatches to it",
  Retire = "the admin retire whole (its own area): main only dispatches to it",
  TopicStream = "a topic's stream whole (its backlog read, resumed and framed): main only dispatches to it, and Backlog (pure, the twin's) holds the rules",
  -- An effect kept apart from what it reads.
  Last = "a topic's count and last message from its sidecar, effectful; main reads both through it, and Count (pure, the twin's) holds the rules",
  -- The dialect's layers, each read beside its Zig file (metal-vmm QUEUE 305).
  MdInline = "the markdown's inline pass whole, markdown_inline.zig's port, read beside it: Md, the block layer, is its one caller",
  Md = "the chat's markdown, markdown.zig's port: twin's until the chat renders with it (QUEUE 306)",
  -- The plants' own (tools/roc_hunt/plants/single_caller/).
  QuietKept = "a plant: allowlisted, so quiet",
}

-- `chat/platform/Host.roc` is `Host`.
function module_of(path)
  local parts = split(path, "/")
  local base = parts[#parts]
  return sub(base, 1, #base - #".roc")
end

-- The first `needle` in `s`, 1-based, or nil.
function find_in_text(s, needle)
  local i = 1
  while i + #needle - 1 <= #s do
    if sub(s, i, i + #needle - 1) == needle then return i end
    i = i + 1
  end
  return nil
end

function single_caller(trees)
  local callers = {}
  local counts = {}
  local first = {}
  local own = {}
  for tree in trees do
    local expect_at = -1
    local i = 1
    while i <= #tree.text do
      local d = tree.depth[i]
      if expect_at >= 0 and d <= expect_at then expect_at = -1 end
      own[module_of(tree.file[i])] = true
      local t = head(tree, i)
      if expect_at < 0 and starts_with(t, "(s-expect ") then expect_at = d end
      if expect_at < 0 and starts_with(t, "(e-ident ") then
        local raw = between(t, "(raw \"", "\")") or ""
        local dot = find_in_text(raw, ".")
        if dot ~= nil and dot > 1 then
          local callee = sub(raw, 1, dot - 1)
          local caller = module_of(tree.file[i])
          if callee ~= caller and lower(sub(callee, 1, 1)) ~= sub(callee, 1, 1) then
            if get(callers, callee) == nil then
              callers[callee] = {}
              counts[callee] = 0
            end
            callers[callee][caller] = true
            counts[callee] = counts[callee] + 1
          end
        end
      end
      i = i + 1
    end
  end
  local found = {}
  for callee in sort(keys(callers)) do
    local from = sort(keys(callers[callee]))
    if #from == 1 and get(own, callee) ~= nil and get(kept_alone, callee) == nil then
      push(found, callee .. ": single_caller: all " .. tostring(counts[callee]) .. " production references come from " .. from[1])
    end
  end
  return found
end

const hunts = {"same_typed_args", "magic_numbers", "bools", "bool_returns", "positional_lists", "if_chains", "long_definitions", "fs_bypass", "html_trusted_nonliteral"}

-- The hunt named `name`, over `tree`.
function hunt(name, tree)
  if name == "same_typed_args" then return same_typed_args(tree) end
  if name == "magic_numbers" then return magic_numbers(tree) end
  if name == "bools" then return bools(tree) end
  if name == "bool_returns" then return bool_returns(tree) end
  if name == "positional_lists" then return positional_lists(tree) end
  if name == "if_chains" then return if_chains(tree) end
  if name == "long_definitions" then return long_definitions(tree) end
  if name == "fs_bypass" then return fs_bypass(tree) end
  if name == "html_trusted_nonliteral" then return html_trusted_nonliteral(tree) end
  fail("no hunt named " .. name)
end

-- **THREE OR MORE ON A LINE, OR A LINE OVER 100 COLUMNS** (metal-vmm
-- QUEUE 296): Shale's cookbook recipe, which reads lines, not the tree,
-- over every chat/ module, twin.roc too. A line coming back long, or a
-- group of three unstacked, is a finding here; `write=1` on the recipe
-- stacks them. Its own plants are its `self_test=1`.
function stack_hunt(globs)
  local found = {}
  for what in globs do
    local r = run({"shale", "cookbook:roc/stack.shale", what}, {timeout_ms = 300000, whole = 4000000})
    if r.code ~= 0 then
      print(r.out)
      fail("cookbook:roc/stack.shale failed")
    end
    for line in lines(r.out) do
      if contains(line, ": stack: ") or contains(line, ": long: ") then push(found, line) end
    end
  end
  print("== stack: " .. tostring(#found))
  for f in found do print("  " .. f) end
end

-- **THE COOKBOOK'S ROC CHECKS THAT GATE** (metal-vmm QUEUE 303): Shale's
-- recipes from the style review, each over every chat/ module (a twin's
-- reference is what keeps a function quiet, and a type declared anywhere
-- is read), their findings kept for the production modules alone, as this
-- hunt's are. Each is a rule of roc-apps docs/roc-style.md that main keeps:
--   - name_hunt `command_tense` and `mixed_tense`: the tags an effect is
--     handed (a `List(T)` as `T`) named as events, or as commands and
--     events at once; `container`: a type or record field named only by
--     container words (`Entry`, `items`), unless its doc says whose
--     (`## A folder's entry`). name_hunt's other checks are questions for a
--     reader, its noun effects many: they do not gate.
--   - boundaries `fixed`: a parameter every production call fills with the
--     same literal (a recursion's `at: 0`); context passed down (`me`) is
--     none. Its `single` (a one-caller wrapper) is the guide's rule of
--     thumb, not a gate.
--   - errors `error_alias`: a result's `Try` naming a shared error alias;
--     `optional_tag`: a tag named as an optional (`None`).
--   - nest_depth `nested` at `min=4`: a call four deep. Three deep is the
--     guide's rule, which main keeps where a reader meets it, but a call of
--     three still stands in some routes and in the twin's dispatch: four
--     is what holds.
-- Their own plants are their `self_test=1`.
const gated = {
  {recipe = "name_hunt", args = {}, checks = {"command_tense", "mixed_tense", "container"}},
  {recipe = "boundaries", args = {}, checks = {"fixed"}},
  {recipe = "errors", args = {}, checks = {"error_alias", "optional_tag"}},
  {recipe = "nest_depth", args = {"min=4"}, checks = {"nested"}},
}

-- **THE PACKAGES THE CHAT IMPORTS, ASKED OF ITS HEADER**: each
-- `name: "../../<repo>/<folder>/main.roc"` in chat/main.roc's app header,
-- as `<repo>/<folder>` under the `repos:` mount, the folder roc-webbox is
-- checked out in. The header is the one home of where a package lives.
function chat_packages()
  local header = between(read("chat/main.roc"), "\napp [", "}")
  if header == nil then fail("chat/main.roc: no app header") end
  local beside = real("repos:")
  if real("repos:roc-webbox") ~= real(".") then
    fail("the hunt: roc-webbox is not checked out under the repos: mount (" .. beside .. "), so its packages beside it cannot be read")
  end
  local found = {}
  for entry in split(header, ",") do
    if contains(entry, ": \"") and not contains(entry, "platform \"") then
      local m = re_find(entry, [=[[a-z_]+: "\.\./\.\./([^"]+)/main\.roc"]=])
      if m == nil then fail("chat/main.roc: a package not beside roc-webbox, which the hunt cannot read: " .. trim(entry)) end
      push(found, m.groups[1])
    end
  end
  return found
end
const packages = chat_packages()

-- A package's modules, as Shale reads them (`repos:<folder>/X.roc`), less
-- its `main.roc`, the package's header.
function package_modules(folder)
  local out = {}
  for p in sort(glob("repos:" .. folder .. "/*.roc")) do
    if not ends_with(p, "/main.roc") then push(out, p) end
  end
  if #out == 0 then fail("the hunt: the package " .. folder .. " has no modules under repos:") end
  return out
end

-- Whether `path` is one of the production modules this hunt reads:
-- chat/*.roc but twin.roc, chat/platform/*.roc, and a package's modules.
function is_production(path)
  for folder in packages do
    for prefix in {"repos:" .. folder .. "/", "../" .. folder .. "/"} do
      if starts_with(path, prefix) then return not contains(sub(path, #prefix + 1), "/") end
    end
  end
  if path == "chat/twin.roc" or not starts_with(path, "chat/") then return false end
  local rest = sub(path, #"chat/" + 1)
  if not contains(rest, "/") then return true end
  return starts_with(rest, "platform/") and not contains(sub(rest, #"platform/" + 1), "/")
end

-- A finding's path: what comes before `:<line>:`, a mount's `repos:` kept.
function finding_path(line)
  local m = re_find(line, "^(.*\\.roc):[0-9]+:")
  if m == nil then return "" end
  return m.groups[1]
end

-- Each recipe reads one glob a run: the chat's, then each package's alone,
-- so a call from the chat into a package is not seen from the package's.
function cookbook_hunt(g, globs)
  local out = ""
  for what in globs do
    local argv = {"shale", "cookbook:roc/" .. g.recipe .. ".shale", what}
    for a in g.args do push(argv, a) end
    local r = run(argv, {timeout_ms = 300000, whole = 4000000})
    if r.code ~= 0 then
      print(r.out)
      fail("cookbook:roc/" .. g.recipe .. ".shale failed")
    end
    out = out .. r.out .. "\n"
  end
  for c in g.checks do
    local found = {}
    for line in lines(out) do
      if contains(line, ": " .. c .. ": ") and is_production(finding_path(line)) then push(found, line) end
    end
    print("== " .. g.recipe .. " " .. c .. ": " .. tostring(#found))
    for f in found do print("  " .. f) end
  end
end

-- ── the plants, or the tree ──────────────────────────────────────────────

if arg("self_test", "") ~= "" then
  -- Every hunt's plants are judged before a failure stops the run, so one
  -- run shows each plant that is wrong.
  local wrong = {}
  for name in hunts do
    local plants = "tools/roc_hunt/plants/" .. name .. ".roc"
    local found = hunt(name, read_trees({plants}))
    local text = join(found, "\n")
    local fires = 0
    local counted = {}
    local before = #wrong
    local n = 0
    for line in lines(read(plants)) do
      n = n + 1
      local named = trim(split(trim(line), " ")[1])
      if starts_with(named, "fires_") and get(counted, named) == nil then
        counted[named] = true
        fires = fires + 1
        if not contains(text, " " .. named .. ":") then push(wrong, name .. ": a plant did not fire: " .. named) end
      end
      -- A plant no name can mark (a type, a name the language fixes) is
      -- its line, ending `# fires` or `# quiet`; `# finding: <text>` is
      -- how a finding must end (a number's mark).
      local at = ".roc:" .. tostring(n) .. " "
      if ends_with(line, "# fires") then
        fires = fires + 1
        if not contains(text, at) then push(wrong, name .. ": a plant did not fire: line " .. tostring(n) .. ", " .. trim(line)) end
      end
      if ends_with(line, "# quiet") and contains(text, at) then push(wrong, name .. ": a quiet plant fired: line " .. tostring(n) .. ", " .. trim(line)) end
      if starts_with(line, "# finding: ") then
        local want = sub(line, #"# finding: " + 1)
        local held = false
        for f in found do if ends_with(f, want) then held = true end end
        if not held then push(wrong, name .. ": no finding ends `" .. want .. "`") end
      end
    end
    if fires == 0 then push(wrong, name .. ": its plants hold no fires_ definition") end
    for f in found do
      if contains(f, " quiet_") then push(wrong, name .. ": a quiet plant fired: " .. f) end
    end
    if #wrong == before then print(name .. ": its " .. tostring(fires) .. " plants fire, and the quiet ones stay quiet") end
  end
  -- single_caller's plants are a folder of modules, main and twin among them.
  local folder = sort(glob("tools/roc_hunt/plants/single_caller/*.roc"))
  local production = {}
  for p in folder do if not ends_with(p, "/twin.roc") then push(production, p) end end
  local said = join(single_caller({read_trees(production), read_trees({"tools/roc_hunt/plants/single_caller/twin.roc"})}), "\n")
  if not contains(said, "FiresSolo: single_caller") then push(wrong, "single_caller: a plant did not fire: FiresSolo") end
  for quiet in {"QuietShared", "QuietKept", "QuietTested", "Iter"} do
    if contains(said, quiet .. ":") then push(wrong, "single_caller: a quiet plant fired: " .. quiet) end
  end
  if contains(said, "FiresSolo") and not contains(said, "Quiet") then print("single_caller: its plant fires, and the quiet ones stay quiet") end
  for w in wrong do print("FAIL " .. w) end
  if #wrong > 0 then fail(tostring(#wrong) .. " plants wrong") end
  local r = run({"shale", "cookbook:roc/stack.shale", "self_test=1"}, {timeout_ms = 300000, tail = 40})
  if r.code ~= 0 then
    print(r.out)
    fail("stack: cookbook:roc/stack.shale's plants failed")
  end
  print("stack: cookbook:roc/stack.shale's plants pass")
  for g in gated do
    local recipe = "cookbook:roc/" .. g.recipe .. ".shale"
    local s = run({"shale", recipe, "self_test=1"}, {timeout_ms = 300000, tail = 40})
    if s.code ~= 0 then
      print(s.out)
      fail(g.recipe .. ": " .. recipe .. "'s plants failed")
    end
    print(g.recipe .. ": " .. recipe .. "'s plants pass")
  end
else
  local files = {}
  for p in glob("chat/*.roc") do if p ~= "chat/twin.roc" then push(files, p) end end
  for p in glob("chat/platform/*.roc") do push(files, p) end
  files = sort(files)
  -- roc-ast reads a path from roc-webbox's root, the package beside it.
  local globs = {"glob=chat/**/*.roc"}
  for folder in packages do
    for p in package_modules(folder) do push(files, "../" .. sub(p, #"repos:" + 1)) end
    push(globs, "glob=repos:" .. folder .. "/*.roc")
  end
  local tree = read_trees(files)
  for name in hunts do
    local found = hunt(name, tree)
    print("== " .. name .. ": " .. tostring(#found))
    for f in found do print("  " .. f) end
  end
  local lone = single_caller({tree, read_trees({"chat/twin.roc"})})
  print("== single_caller: " .. tostring(#lone))
  for f in lone do print("  " .. f) end
  stack_hunt(globs)
  for g in gated do cookbook_hunt(g, globs) end
end
