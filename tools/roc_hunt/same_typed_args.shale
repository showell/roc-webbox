-- **CONSECUTIVE ARGUMENTS OF ONE TYPE**: a function annotated with two or
-- more neighbouring arguments of the same type (`List(U8), List(U8)`) takes
-- them in an order nothing checks: swapped, they still type-check. The fix
-- is a record (named fields, no order) or a nominal type (an id is not a
-- path), or both. Type variables (`a, a`) are not counted: a comparator's
-- two sides are one type by design. Read with Roc's own parser (roc-ast,
-- tools/roc_ast/install.shale). Run from roc-webbox:
--   shale tools/roc_hunt/same_typed_args.shale               chat/, every .roc
--   shale tools/roc_hunt/same_typed_args.shale self_test=1   its plants first

const roc_ast = "/home/steve/tools/roc-ast/bin/roc-ast"

-- How deep a tree line is: its leading tabs.
function depth(line)
  local n = 0
  while sub(line, n + 1, n + 1) == "\t" do n = n + 1 end
  return n
end

-- A type's lines as one comparable string: each line's tokens without
-- positions or parentheses, beside its depth below the type's first line.
function shape(tree, first, last)
  local base = depth(tree[first])
  local out = {}
  local i = first
  while i <= last do
    local words = {}
    for w in split(trim(tree[i]), " ") do
      if not starts_with(w, "@") then push(words, w) end
    end
    local text = join(words, " ")
    text = join(split(text, "("), "")
    text = join(split(text, ")"), "")
    push(out, tostring(depth(tree[i]) - base) .. ":" .. text)
    i = i + 1
  end
  return join(out, " | ")
end

-- The type whose tree starts at line `at`, as Roc writes it: `List(U8)`,
-- `{ id : U8 }`, `[Found, Missing]`.
function render(tree, at)
  local d = depth(tree[at])
  local t = trim(tree[at])
  local kids = {}
  local i = at + 1
  while i <= #tree and depth(tree[i]) > d do
    if depth(tree[i]) == d + 1 then push(kids, i) end
    i = i + 1
  end
  local name = between(t, "(name \"", "\")")
  if starts_with(t, "(ty-apply ") then
    local args = {}
    local k = 2
    while k <= #kids do push(args, render(tree, kids[k])) k = k + 1 end
    return render(tree, kids[1]) .. "(" .. join(args, ", ") .. ")"
  end
  if starts_with(t, "(ty-record ") or starts_with(t, "(ty-tuple ") or starts_with(t, "(tags") then
    local parts = {}
    for k in kids do push(parts, render(tree, k)) end
    if starts_with(t, "(ty-record ") then return "{ " .. join(parts, ", ") .. " }" end
    if starts_with(t, "(ty-tuple ") then return "(" .. join(parts, ", ") .. ")" end
    return join(parts, ", ")
  end
  if starts_with(t, "(ty-tag-union ") then return "[" .. render(tree, kids[1]) .. "]" end
  if starts_with(t, "(anno-record-field ") then return name .. " : " .. render(tree, kids[1]) end
  if name ~= nil and name ~= "" then return name end
  return split(t, " ")[1] .. ")"
end

-- The argument types of the `ty-fn` at line `at`: a list of {shape, line},
-- the return type (its last child) left out.
function arguments(tree, at)
  local child = depth(tree[at]) + 1
  local starts = {}
  local i = at + 1
  while i <= #tree and depth(tree[i]) >= child do
    if depth(tree[i]) == child then push(starts, i) end
    i = i + 1
  end
  local stop = i - 1
  local out = {}
  local k = 1
  while k < #starts do
    local last = stop
    if k + 1 <= #starts then last = starts[k + 1] - 1 end
    push(out, {shape(tree, starts[k], last), starts[k]})
    k = k + 1
  end
  return out
end

-- Every run of same-typed neighbouring arguments in roc-ast's output for
-- `files`, a line each: `<file>:<line> <name>: arguments i-j are <type>`.
function hunt(files)
  local found = {}
  local dump = run({roc_ast}, {timeout_ms = 300000, stdin = join(files, "\n"), whole = 64000000})
  local tree = lines(dump.out)
  local file = ""
  local i = 1
  while i <= #tree do
    local line = tree[i]
    if starts_with(line, "== ") then file = sub(line, 4) end
    local t = trim(line)
    if starts_with(t, "(s-type-anno ") and i < #tree and starts_with(trim(tree[i + 1]), "(ty-fn ") then
      local name = between(t, "(name \"", "\")")
      local row = between(t, "@", ".")
      local args = arguments(tree, i + 1)
      local a = 1
      while a < #args do
        local b = a
        while b < #args and args[b + 1][1] == args[a][1] do b = b + 1 end
        if b > a and not contains(args[a][1], "ty-var") then
          push(found, file .. ":" .. row .. " " .. name .. ": arguments " .. tostring(a) .. "-" .. tostring(b) .. " are " .. render(tree, args[a][2]))
        end
        a = b + 1
      end
    end
    i = i + 1
  end
  return found
end

if arg("self_test", "") ~= "" then
  local found = hunt({"tools/roc_hunt/plants/same_typed_args.roc"})
  local text = join(found, "\n")
  for name in {"fires_two_bytes", "fires_last_three", "fires_records", "fires_associated"} do
    if not contains(text, " " .. name .. ":") then fail("same-typed arguments: a plant did not fire: " .. name .. "\n" .. text) end
  end
  for f in found do
    if contains(f, " quiet_") then fail("same-typed arguments: a quiet plant fired: " .. f) end
  end
  if not contains(text, "fires_last_three: arguments 2-4 are Str") then fail("same-typed arguments: the run is not 2-4 of Str:\n" .. text) end
  if not contains(text, "fires_two_bytes: arguments 1-2 are List(U8)") then fail("same-typed arguments: List(U8) is not rendered so:\n" .. text) end
  if not contains(text, "fires_records: arguments 1-2 are { id : U8 }") then fail("same-typed arguments: a record is not rendered so:\n" .. text) end
  print("same-typed arguments: its plants fire (two, a run of three, records, an associated function) and the quiet ones stay quiet")
else
  local files = {}
  for p in glob("chat/**/*.roc") do push(files, p) end
  local found = hunt(sort(files))
  for f in found do print(f) end
  print("same-typed arguments: " .. tostring(#found) .. " runs in " .. tostring(#files) .. " files")
end
