-- **HOW MUCH OF THE CHAT IS STILL ZIG**, read from the code: Roc's own
-- parser (roc-ast) for the Roc, Zig's (zig_decls, zig_imports, zig_tokens)
-- for angry-gopher's Zig. Four reports, then one number to watch:
--
--   - **routes**: every route, the families, parts and tails from
--     chat/Route.roc and the static scripts, each the Roc's: the census
--     stops if the Roc can hand one back to Zig again;
--   - **hosted functions**: each of chat/platform/Host.roc's, the
--     chat_router.zig `Call` member that answers it, its own tokens plus
--     what it calls one level deep (a Call member or a chat file's
--     declaration), and the chat Zig it reaches in all; classed `primitive`
--     (reaches no chat Zig), `whole feature` (reaches over
--     `feature_tokens`) or `primitive + decisions` (between);
--   - **the old chat from outside**: each call into the chat's Zig from a
--     file that is not the chat's, a test's, a twin's or a bench's, by
--     caller (login.zig's welcome DM, docs, the router);
--   - **dead**: chat declarations no live root reaches, by file.
--
-- **THE CHAT'S ZIG** is chat*.zig and `chat_set` below (the features the
-- chat once served in Zig); twins, tests and benches are never counted. **LIVE** is what
-- the roots reach, a top-level declaration a node: chat_router.zig's
-- `handle` and every declaration a call from outside names, then each
-- declaration's bare names in its file and `alias.name` through an import.
-- A container (`Call`) is reached whole.
--
-- **SIZE IS CODE, NOT LAYOUT**: the Zig in tokens (zig_tokens: no comment, no
-- doc comment, and no trailing comma, which is how zig fmt is told to stack
-- a list one item a line), the Roc in parse nodes (roc-ast's, one a line of
-- its dump), of chat/*.roc and chat/platform/*.roc less twin.roc; Zig's
-- tests left out. Code lines (not blank, not a comment) are printed beside
-- them, marked as layout's: stacking a call one argument a line adds lines
-- and no code.
--
-- Run from roc-webbox, angry-gopher's zig-server given as a mount path (a
-- script's path may hold no `..`):
--   shale tools/roc_hunt/zig_census.shale [gopher=repos:angry-gopher-chat/zig-server]
-- budget: steps=400000000 arena_bytes=4000000000

const roc_ast = real("tools:roc-ast/bin/roc-ast")
const gopher = arg("gopher", "repos:angry-gopher-chat/zig-server")
const src = gopher .. "/src/"
-- A hosted function reaching more chat Zig than this is a whole feature:
-- the 300 code lines it was, at the 12.0 tokens a line of the live chat Zig
-- before it was stacked (34,923 / 2,907). Any of 916..6,053 classes those
-- the same; 3,600 sits inside that gap.
const feature_tokens = 3600
-- A dead declaration this size or more is named in the by-file report.
const named_dead_tokens = 50
const chat_set = " presence.zig recent.zig recent_feed.zig reactions.zig images.zig images_store.zig code.zig code_store.zig docs.zig docs_store.zig search_index.zig search_tokens.zig "

function is_aside(name)
  return ends_with(name, "_test.zig") or contains(name, "twin") or contains(name, "_bench") or contains(name, "probe") or name == "router_harness.zig"
end

function is_chat(name)
  return (starts_with(name, "chat") or contains(chat_set, " " .. name .. " ")) and not is_aside(name)
end

-- A line that is code: not blank, not a comment.
function is_code(line)
  local t = trim(line)
  return t ~= "" and not starts_with(t, "//") and not starts_with(t, "#")
end

function code_lines(text, first, last)
  local n = 0
  local i = first
  while i <= last do
    if is_code(text[i]) then n = n + 1 end
    i = i + 1
  end
  return n
end

-- Lines `first`..`last` of a read file `f` ({text, tokens, at_line}):
-- {first, last, tokens, lines}, tokens the size, lines layout's.
function sized(f, first, last)
  local n = 0
  local toks = f.tokens
  local i = f.at_line[first]
  while i <= #toks and toks[i].line <= last do
    local tag = toks[i].tag
    local trailing = tag == "comma" and i < #toks and (toks[i + 1].tag == "r_paren" or toks[i + 1].tag == "r_brace" or toks[i + 1].tag == "r_bracket")
    if tag ~= "doc_comment" and tag ~= "container_doc_comment" and not trailing then n = n + 1 end
    i = i + 1
  end
  return {first = first, last = last, tokens = n, lines = code_lines(f.text, first, last)}
end

-- `a` and `b` ({tokens, lines}) summed.
function plus(a, b)
  return {tokens = a.tokens + b.tokens, lines = a.lines + b.lines}
end

const nothing = {tokens = 0, lines = 0}

-- ── the Zig, read once ───────────────────────────────────────────────────

-- Each file: its lines, its top-level declarations by name, and its import
-- aliases (`alias` -> {file, member}; member "" for a whole file).
function read_zig(names)
  local files = {}
  for name in names do
    local path = src .. name
    local text = lines(read(path))
    local aliases = {}
    for im in zig_imports(path) do
      if ends_with(im.target, ".zig") then
        local alias = im.name
        local member = ""
        local m = re_find(text[im.line], "\\)\\.([A-Za-z_]+)")
        if m ~= nil then member = m.group end
        if alias == "" or alias == nil then
          local c = re_find(text[im.line], "const ([A-Za-z_]+) =")
          if c ~= nil then alias = c.group end
        end
        if alias ~= nil and alias ~= "" then aliases[alias] = {file = im.target, member = member} end
      end
    end
    local tokens = zig_tokens(path)
    -- The first token on or after each line, so a declaration's tokens are
    -- found without walking the file's.
    local at_line = {}
    local j = 1
    local ln = 1
    while ln <= #text + 1 do
      while j <= #tokens and tokens[j].line < ln do j = j + 1 end
      push(at_line, j)
      ln = ln + 1
    end
    local f = {text = text, tokens = tokens, at_line = at_line}
    local decls = {}
    local order = {}
    for d in zig_decls(path) do
      if d.kind ~= "test" and d.kind ~= "comptime" and d.name ~= nil and d.name ~= "" then
        decls[d.name] = sized(f, d.first, d.last)
        push(order, d.name)
      end
    end
    files[name] = {text = text, decls = decls, order = order, aliases = aliases, tokens = tokens, at_line = at_line}
  end
  return files
end

-- What lines `first`..`last` of file `name` name: {file, decl} pairs, a
-- bare name of the file's own or `alias.name` through an import of a file
-- in `files`.
function refs(files, name, first, last)
  local f = files[name]
  local out = {}
  local seen = {}
  local toks = f.tokens
  local i = f.at_line[first]
  while i <= #toks and toks[i].line <= last do
    local t = toks[i]
    if t.tag == "identifier" then
      local after_dot = i > 1 and toks[i - 1].tag == "period"
      local target = nil
      local al = get(f.aliases, t.text)
      if not after_dot and al ~= nil and has_key(files, al.file) then
        if al.member ~= "" then
          target = {al.file, al.member}
        elseif i + 2 <= #toks and toks[i + 1].tag == "period" and toks[i + 2].tag == "identifier" then
          target = {al.file, toks[i + 2].text}
        end
      elseif not after_dot and has_key(f.decls, t.text) then
        target = {name, t.text}
      end
      if target ~= nil and has_key(files[target[1]].decls, target[2]) then
        local key = target[1] .. ":" .. target[2]
        if not has_key(seen, key) then
          seen[key] = true
          push(out, target)
        end
      end
    end
    i = i + 1
  end
  return out
end

-- Every declaration reached from `roots` ({file, decl} pairs), over the
-- chat files: a set of `file:decl`.
function reach(files, roots)
  local seen = {}
  local work = {}
  for r in roots do push(work, r) end
  while #work > 0 do
    local r = work[#work]
    work = take(work, #work - 1)
    local key = r[1] .. ":" .. r[2]
    if not has_key(seen, key) then
      seen[key] = true
      local d = files[r[1]].decls[r[2]]
      for n in refs(files, r[1], d.first, d.last) do push(work, n) end
    end
  end
  return seen
end

-- The size of the declarations in `seen`, a set of `file:decl`.
function reached_size(files, seen, chat_only)
  local n = nothing
  for key in keys(seen) do
    local parts = split(key, ":")
    if not chat_only or parts[1] ~= "chat_router.zig" then n = plus(n, files[parts[1]].decls[parts[2]]) end
  end
  return n
end

-- `s` ({tokens, lines}) as the reports print it: `<tokens> (<code lines>)`.
function shown(s)
  return tostring(s.tokens) .. " (" .. tostring(s.lines) .. ")"
end

-- ── the Roc ──────────────────────────────────────────────────────────────

-- A type's tags, as chat/Route.roc spells them: `Family : [A, B, ...]`, on
-- one line or stacked one a line (the trailing comma no tag).
function tags(text, name)
  local m = re_find(text, "\n\t" .. name .. " : \\[([^\\]]*)\\]")
  if m == nil then fail("chat/Route.roc: no `" .. name .. " : [...]`") end
  local out = {}
  for s in split(m.group, ",") do if trim(s) ~= "" then push(out, trim(s)) end end
  return out
end

-- ── the census ───────────────────────────────────────────────────────────

local names = {}
for p in glob(src .. "*.zig") do
  local base = split(p, "/")
  local name = base[#base]
  if not is_aside(name) then push(names, name) end
end
local all = read_zig(sort(names))
local chat = {}
for name in names do if is_chat(name) then chat[name] = all[name] end end
local live_files = {}
for name in names do live_files[name] = all[name] end

-- The roots: chat_router.handle, and each call from a live file outside
-- the chat into it.
local roots = {{"chat_router.zig", "handle"}}
local outside = {}
for name in sort(names) do
  if not is_chat(name) then
    local f = all[name]
    for dn in f.order do
      local d = f.decls[dn]
      for r in refs(all, name, d.first, d.last) do
        if is_chat(r[1]) then
          push(roots, r)
          push(outside, name .. " " .. dn .. " -> " .. r[1] .. " " .. r[2])
        end
      end
    end
  end
end
local live = reach(chat, roots)

-- Routes. **A ROUTE IS ZIG'S ONLY IF THE ROC CAN HAND ONE BACK**: an
-- answer that names a route for the host to serve (Chat.roc's `Answer`
-- with a `route` field, its `Kind` a `Serve`) and the Zig that serves it
-- (chat.zig). With none of them, every route chat/Route.roc parses is the
-- Roc's, and the script before the gate (`Route.asset`, the host's bytes
-- through `serve_script!`) too. One of them back stops the census: count
-- its routes here again.
local route_text = read("chat/Route.roc")
local chat_roc = read("chat/platform/Chat.roc")
local main_text = read("chat/main.roc")
if contains(chat_roc, "\n\t\tServe,") or contains(chat_roc, "\n\t\troute : ") or exists(src .. "chat.zig") then
  fail("routes: the Roc can hand a route back to Zig again (Chat.roc's Answer has a route, or chat.zig is back): count them in the census")
end
if not contains(main_text, "Route.asset(") or not contains(main_text, "Host.serve_script!(") then
  fail("routes: chat/main.roc serves the static scripts some other way than Route.asset and Host.serve_script!: count them in the census")
end
local roc_routes = 0
print("== routes (chat/Route.roc's, and the static scripts; Zig's: none can be handed back)")
print("  Roc  Script (/chat/<name>.js)")
roc_routes = roc_routes + 1
for fam in tags(route_text, "Family") do
  local labels = {}
  if fam == "Dm" or fam == "Channel" then
    for part in tags(route_text, "Part") do
      if part == "Topic" then
        for tail in tags(route_text, "Tail") do push(labels, fam .. " " .. part .. " " .. tail) end
      else
        push(labels, fam .. " " .. part)
      end
    end
  elseif fam == "Recent" or fam == "Images" or fam == "Code" then
    push(labels, fam)
    push(labels, fam .. " /stream")
  else
    push(labels, fam)
  end
  for label in labels do
    roc_routes = roc_routes + 1
    print("  Roc  " .. label)
  end
end
print("  " .. tostring(roc_routes) .. " Roc's, 0 Zig's")

-- Hosted functions.
print("")
print("== hosted functions (Host.roc; chat_router.zig Call; own+one level / chat Zig reached, in tokens (code lines, layout's))")
local router = all["chat_router.zig"]
local members = {}
for d in zig_decls(src .. "chat_router.zig", {container = "Call"}) do
  if d.kind ~= "field" and d.kind ~= "test" then members[d.name] = sized(router, d.first, d.last) end
end
local wiring = {}
local h = members["host"]
local k = h.first
while k <= h.last do
  local m = re_find(router.text[k], "^\\s+\\.([a-z_]+) = [a-zA-Z_]+,")
  if m ~= nil and m.group ~= "ctx" then
    local fn = trim(split(split(router.text[k], "=")[2], ",")[1])
    wiring[m.group] = fn
  end
  k = k + 1
end
local hosted = {}
for line in lines(read("chat/platform/Host.roc")) do
  local m = re_find(line, "^\\t([a-z_]+)! :")
  if m ~= nil then push(hosted, m.group) end
end
-- A hosted effect's Call member is the host field its export asks for
-- (`roc_chat_read_stat` asks `current("stat")`): a Roc name and the
-- host's field may differ (metal-vmm QUEUE 297's renames).
local field_of = {}
local export_now = nil
for line in lines(read("src/chat_abi.zig")) do
  local e = re_find(line, "^export fn roc_chat_([a-z_]+)\\(")
  if e ~= nil then export_now = e.group end
  local c = re_find(line, "current\\(\"([a-z_]+)\"\\)")
  if c ~= nil and export_now ~= nil then
    field_of[export_now] = c.group
    export_now = nil
  end
end
local classes = {}
for name in hosted do
  local fn = get(wiring, get(field_of, name, name))
  if fn == nil then
    print("  " .. name .. "!  (no Call member wired)")
  else
    local mem = members[fn]
    local one = mem
    local reached_roots = {}
    local callees = {}
    -- One level: Call's own members it names, and chat declarations.
    local seen = {}
    for t in router.tokens do
      if t.line >= mem.first and t.line <= mem.last and t.tag == "identifier" and t.text ~= fn and has_key(members, t.text) and not has_key(seen, t.text) and t.text ~= "of" then
        seen[t.text] = true
        one = plus(one, members[t.text])
        push(callees, t.text)
        for r in refs(chat, "chat_router.zig", members[t.text].first, members[t.text].last) do if r[1] ~= "chat_router.zig" then push(reached_roots, r) end end
      end
    end
    for r in refs(chat, "chat_router.zig", mem.first, mem.last) do
      if r[1] ~= "chat_router.zig" then
        one = plus(one, chat[r[1]].decls[r[2]])
        push(callees, sub(r[1], 1, #r[1] - 4) .. "." .. r[2])
        push(reached_roots, r)
      end
    end
    local deep = reached_size(chat, reach(chat, reached_roots), true)
    local class = "primitive + decisions"
    if deep.tokens == 0 then class = "primitive" end
    if deep.tokens > feature_tokens then class = "whole feature" end
    classes[class] = get(classes, class, 0) + 1
    print("  " .. name .. "!  " .. fn .. "  " .. shown(one) .. " / " .. shown(deep) .. "  " .. class .. "  [" .. join(callees, ", ") .. "]")
  end
end
for c in sort(keys(classes)) do print("  " .. c .. ": " .. tostring(classes[c])) end

-- The old chat from outside.
print("")
print("== the chat's Zig called from outside it (caller -> callee)")
for o in sort(outside) do print("  " .. o) end

-- Dead and live, by file.
print("")
print("== the chat's Zig by file: live / dead in tokens (code lines, layout's) (dead: no root reaches it)")
local live_total = nothing
local dead_total = nothing
for name in sort(keys(chat)) do
  local f = chat[name]
  local l = nothing
  local d = nothing
  local dead_names = {}
  for dn in f.order do
    local n = f.decls[dn]
    if has_key(live, name .. ":" .. dn) then l = plus(l, n) else
      d = plus(d, n)
      if n.tokens >= named_dead_tokens then push(dead_names, dn .. "(" .. tostring(n.tokens) .. ")") end
    end
  end
  live_total = plus(live_total, l)
  dead_total = plus(dead_total, d)
  local line = "  " .. name .. "  " .. shown(l) .. " / " .. shown(d)
  if #dead_names > 0 and #dead_names <= 12 then line = line .. "  dead: " .. join(dead_names, " ") end
  if #dead_names > 12 then line = line .. "  dead: " .. tostring(#dead_names) .. " declarations" end
  print(line)
end

-- The Roc: its parse nodes, a line of roc-ast's dump each (a file's
-- `== <path>` heading is none), and its code lines.
local roc_files = {}
for p in glob("chat/*.roc") do if p ~= "chat/twin.roc" then push(roc_files, p) end end
for p in glob("chat/platform/*.roc") do push(roc_files, p) end
roc_files = sort(roc_files)
local dump = run({roc_ast}, {timeout_ms = 300000, stdin = join(roc_files, "\n"), whole = 64000000})
if dump.code ~= 0 then fail("roc-ast failed on the chat's Roc") end
local roc_nodes = 0
for line in lines(dump.out) do
  if starts_with(trim(line), "(") then roc_nodes = roc_nodes + 1 end
end
local roc_lines = 0
for p in roc_files do
  local text = lines(read(p))
  roc_lines = roc_lines + code_lines(text, 1, #text)
end

print("")
print("== the number to watch: the chat's Zig on live paths " .. tostring(live_total.tokens) .. " tokens (" .. tostring(dead_total.tokens) .. " unreached), its Roc " .. tostring(roc_nodes) .. " parse nodes")
print("   in code lines, which layout moves: Zig " .. tostring(live_total.lines) .. " (" .. tostring(dead_total.lines) .. " unreached), Roc " .. tostring(roc_lines))
