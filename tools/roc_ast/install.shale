-- **ROC-AST, BUILT AT THE PIN AND INSTALLED** where Shale may run it
-- (~/tools/roc-ast/bin/roc-ast, under the `tools` mount). The parser is
-- roc-lang/roc's at the commit roc-version names: build.zig.zon pins that
-- commit's archive by hash, and the build forks it to a full worktree of the
-- same commit (the archive's package leaves out vendor/, which the parser's
-- modules import). Built with Zig 0.16.0, the pinned Roc's (build.zig says
-- why). Run from roc-webbox:
--   shale tools/roc_ast/install.shale

local home = "/home/steve"
local version = trim(read("roc-version"))
local parts = split(version, "-")
local short = parts[#parts]
local zon = read("tools/roc_ast/build.zig.zon")
local at = find(zon, "/archive/")
if at == nil then fail("roc-ast: build.zig.zon names no roc archive") end
local commit = sub(zon, at + 9, at + 48)
if not starts_with(commit, short) then
  fail("roc-ast: roc-version pins Roc " .. short .. ", build.zig.zon fetches " .. commit .. ": zig fetch --save=roc the pinned commit's archive")
end

local src = home .. "/tools/roc-" .. short
local head = trim(run({"git", "-C", src, "rev-parse", "HEAD"}, {timeout_ms = 30000, whole = 200}).out)
if head ~= commit then
  fail("roc-ast: " .. src .. " is at " .. head .. ", not " .. commit .. ": git -C ~/tools/roc-pr worktree add --detach " .. src .. " " .. commit)
end

local built = run({home .. "/zig-0.16.0/zig", "build", "--fork=" .. src, "--prefix", home .. "/tools/roc-ast"}, {timeout_ms = 1800000, tail = 20, cwd = "tools/roc_ast"})
print(built.out)
print("roc-ast: Roc " .. short .. "'s parser, installed at ~/tools/roc-ast/bin/roc-ast")
